# Only publish the current add-on and release documentation.
/*
!/.gitignore
!/README.md
!/CHANGELOG.md
!/LICENSE
!/tools/
/tools/*
!/tools/package.py
!/mmd_unity_exporter/
/mmd_unity_exporter/*
!/mmd_unity_exporter/__init__.py
!/mmd_unity_exporter/blender_manifest.toml
!/mmd_unity_exporter/materials.py
!/mmd_unity_exporter/exporter.py

# Publish only the README screenshots from the local docs directory.
!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/panel-default.png
!/docs/images/export-modes.png
!/docs/images/material-classification.png
